---
import BaseLayout from "../layouts/BaseLayout.astro";
import CreativityLogoSet from "../components/CreativityLogoSet.astro";
import appleText from "../data/apple.jsonc?raw";
import { parseJsonc, type LocalizedText } from "../lib/parse-jsonc";
import { withBase } from "../lib/site-path";

const apple = parseJsonc<{
  pageTitle: LocalizedText;
  pageSubtitle: LocalizedText;
  servicesTitle: LocalizedText;
  plansTitle: LocalizedText;
  planTableHeadings: Record<keyof LocalizedText, [string, string, string]>;
  carouselLogos: {
    name: string;
    color: string;
    labelColor: string;
    icon: string;
    href: string;
  }[];
  plans: {
    name: string;
    included: LocalizedText;
    price: LocalizedText;
  }[];
}>(
  appleText,
  "src/data/apple.jsonc",
);
const carouselLogos = apple.carouselLogos;
const splitIndex = Math.ceil(carouselLogos.length / 2);
const logoRows = [
  { items: carouselLogos.slice(0, splitIndex), reverse: false },
  { items: carouselLogos.slice(splitIndex), reverse: true },
];
const pageTranslations = {
  "zh-Hans": {
    applePageTitle: apple.pageTitle["zh-Hans"],
    applePageSubtitle: apple.pageSubtitle["zh-Hans"],
    appleServicesTitle: apple.servicesTitle["zh-Hans"],
    applePlansTitle: apple.plansTitle["zh-Hans"],
    applePlanNameHeading: apple.planTableHeadings["zh-Hans"][0],
    applePlanServicesHeading: apple.planTableHeadings["zh-Hans"][1],
    applePlanPriceHeading: apple.planTableHeadings["zh-Hans"][2],
    ...Object.fromEntries(apple.plans.flatMap((plan, index) => [
      [`applePlanIncluded${index}`, plan.included["zh-Hans"]],
      [`applePlanPrice${index}`, plan.price["zh-Hans"]],
    ])),
  },
  "zh-Hant": {
    applePageTitle: apple.pageTitle["zh-Hant"],
    applePageSubtitle: apple.pageSubtitle["zh-Hant"],
    appleServicesTitle: apple.servicesTitle["zh-Hant"],
    applePlansTitle: apple.plansTitle["zh-Hant"],
    applePlanNameHeading: apple.planTableHeadings["zh-Hant"][0],
    applePlanServicesHeading: apple.planTableHeadings["zh-Hant"][1],
    applePlanPriceHeading: apple.planTableHeadings["zh-Hant"][2],
    ...Object.fromEntries(apple.plans.flatMap((plan, index) => [
      [`applePlanIncluded${index}`, plan.included["zh-Hant"]],
      [`applePlanPrice${index}`, plan.price["zh-Hant"]],
    ])),
  },
  ja: {
    applePageTitle: apple.pageTitle.ja,
    applePageSubtitle: apple.pageSubtitle.ja,
    appleServicesTitle: apple.servicesTitle.ja,
    applePlansTitle: apple.plansTitle.ja,
    applePlanNameHeading: apple.planTableHeadings.ja[0],
    applePlanServicesHeading: apple.planTableHeadings.ja[1],
    applePlanPriceHeading: apple.planTableHeadings.ja[2],
    ...Object.fromEntries(apple.plans.flatMap((plan, index) => [
      [`applePlanIncluded${index}`, plan.included.ja],
      [`applePlanPrice${index}`, plan.price.ja],
    ])),
  },
  ko: {
    applePageTitle: apple.pageTitle.ko,
    applePageSubtitle: apple.pageSubtitle.ko,
    appleServicesTitle: apple.servicesTitle.ko,
    applePlansTitle: apple.plansTitle.ko,
    applePlanNameHeading: apple.planTableHeadings.ko[0],
    applePlanServicesHeading: apple.planTableHeadings.ko[1],
    applePlanPriceHeading: apple.planTableHeadings.ko[2],
    ...Object.fromEntries(apple.plans.flatMap((plan, index) => [
      [`applePlanIncluded${index}`, plan.included.ko],
      [`applePlanPrice${index}`, plan.price.ko],
    ])),
  },
  en: {
    applePageTitle: apple.pageTitle.en,
    applePageSubtitle: apple.pageSubtitle.en,
    appleServicesTitle: apple.servicesTitle.en,
    applePlansTitle: apple.plansTitle.en,
    applePlanNameHeading: apple.planTableHeadings.en[0],
    applePlanServicesHeading: apple.planTableHeadings.en[1],
    applePlanPriceHeading: apple.planTableHeadings.en[2],
    ...Object.fromEntries(apple.plans.flatMap((plan, index) => [
      [`applePlanIncluded${index}`, plan.included.en],
      [`applePlanPrice${index}`, plan.price.en],
    ])),
  },
};
---

<BaseLayout
  title={apple.pageTitle["zh-Hans"]}
  description={apple.pageSubtitle["zh-Hans"]}
  image={withBase("/og/pages/apple.png?v=10")}
  imageAlt={apple.pageTitle["zh-Hans"]}
  imageWidth={1800}
  imageHeight={600}
  pageType="standard"
  pageTranslations={pageTranslations}
  titleTranslationKey="applePageTitle"
>
  <main class="container apple-page">
    <header class="content-page-heading">
      <h1 data-i18n="applePageTitle">{apple.pageTitle["zh-Hans"]}</h1>
      <p data-i18n="applePageSubtitle">{apple.pageSubtitle["zh-Hans"]}</p>
    </header>

    <section class="about-skills" aria-labelledby="apple-services-title">
      <h2 id="apple-services-title" data-i18n="appleServicesTitle">{apple.servicesTitle["zh-Hans"]}</h2>
      <div
        class="about-skills-marquee"
        role="group"
        aria-label={apple.servicesTitle["zh-Hans"]}
        data-i18n-aria="appleServicesTitle"
      >
        {logoRows.map(({ items, reverse }) => (
          <div class:list={["about-skills-row", reverse && "about-skills-row-reverse"]}>
            <div class="about-skills-track">
              <CreativityLogoSet items={items} />
              <CreativityLogoSet items={items} hidden />
              <CreativityLogoSet items={items} hidden />
            </div>
          </div>
        ))}
      </div>
    </section>

    <section class="apple-plans" aria-labelledby="apple-plans-title">
      <h2 id="apple-plans-title" data-i18n="applePlansTitle">{apple.plansTitle["zh-Hans"]}</h2>
      <div class="apple-plans-table-wrapper">
        <table aria-labelledby="apple-plans-title">
          <thead>
            <tr>
              <th scope="col" data-i18n="applePlanNameHeading">{apple.planTableHeadings["zh-Hans"][0]}</th>
              <th scope="col" data-i18n="applePlanServicesHeading">{apple.planTableHeadings["zh-Hans"][1]}</th>
              <th scope="col" data-i18n="applePlanPriceHeading">{apple.planTableHeadings["zh-Hans"][2]}</th>
            </tr>
          </thead>
            <tbody>
              {apple.plans.map((plan, index) => (
                <tr>
                  <td>{plan.name}</td>
                  <td data-i18n={`applePlanIncluded${index}`}>{plan.included["zh-Hans"]}</td>
                  <td data-i18n={`applePlanPrice${index}`}>{plan.price["zh-Hans"]}</td>
                </tr>
              ))}
            </tbody>
          </table>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  .apple-page {
    padding-top: 28px;
    padding-bottom: 96px;
  }

  @media (max-width: 680px) {
    .apple-page {
      padding-top: 22px;
      padding-bottom: 68px;
    }
  }

  .about-skills-marquee {
      position: absolute;
      inset: 100px 0 34px;
      display: grid;
      grid-template-rows: repeat(2, minmax(0, 1fr));
      align-content: end;
      gap: 14px;
      overflow: hidden;
      pointer-events: none;
  }

  .about-skills-row {
      min-width: 0;
      overflow: hidden;
  }

  .about-skills {
      position: relative;
      min-height: 430px;
      margin-top: 36px;
      padding: 30px 32px;
      overflow: hidden;
      border: 1px solid var(--line);
      border-radius: 21px;
      background: var(--surface);
  }

  .about-skills h2 {
      position: relative;
      z-index: 1;
      margin: 0;
      color: var(--text);
      font-size: clamp(2rem, 3.8vw, 2.65rem);
      line-height: 1.15;
      letter-spacing: -0.04em;
  }

  .about-skills-track {
      display: flex;
      width: max-content;
      animation: about-skills-scroll 68s linear infinite;
      will-change: transform;
  }

  :global(html[data-about-carousel-transition]) .about-skills-track {
      animation-play-state: paused;
  }

  .about-skills-row-reverse .about-skills-track {
      animation-direction: reverse;
      animation-duration: 75s;
  }

  .about-skills-track :global(.creativity-set) {
      align-items: flex-end;
      gap: 14px;
      padding: 0 14px 0 0;
  }

  .about-skills-track :global(.creativity-logo) {
      width: 140px;
      border-radius: 22px;
      background: var(--logo-bg);
      opacity: 1;
  }

  .about-skills-track :global(.creativity-logo img) {
      width: 70%;
      height: 70%;
  }

  .apple-plans {
    margin-top: 36px;
    padding: 30px 32px;
    border: 1px solid var(--line);
    border-radius: 21px;
    background: var(--surface);
  }

  .apple-plans h2 {
    margin: 0 0 20px;
    color: var(--text);
    font-size: clamp(1.6rem, 3vw, 2rem);
    line-height: 1.2;
    letter-spacing: -0.04em;
  }

  .apple-plans-table-wrapper {
    overflow-x: auto;
  }

  .apple-plans table {
    width: 100%;
    min-width: 440px;
    border-collapse: collapse;
    color: var(--text);
    text-align: left;
  }

  .apple-plans th {
    padding: 14px 16px;
    border-bottom: 1px solid var(--line);
    color: var(--muted);
    font-size: 0.9rem;
    font-weight: 650;
  }

  @keyframes about-skills-scroll {
      to {
        transform: translateX(-33.333333%);
      }
  }

  @media (max-width: 680px) {
      .about-skills {
        min-height: 0;
        margin-top: 28px;
        padding: 22px 16px;
      }

      .apple-plans {
        margin-top: 28px;
        padding: 22px 16px;
      }

      .about-skills-marquee {
        position: relative;
        inset: auto;
        grid-template-rows: repeat(2, 58px);
        gap: 6px;
        margin-top: 14px;
        width: calc(100% + 32px);
        margin-inline: -16px;
      }

      .about-skills-row {
        display: block;
        overflow: hidden;
      }

      .about-skills-track {
        display: flex;
        width: max-content;
        animation: about-skills-scroll 68s linear infinite;
        will-change: transform;
      }

      .about-skills-track :global(.creativity-set) {
        display: flex;
        flex: none;
        gap: 6px;
        padding-right: 6px;
      }

      .about-skills-track :global(.creativity-logo) {
        flex: none;
        width: 58px;
        height: 58px;
        max-height: none;
        aspect-ratio: 1;
        border-radius: 10px;
      }
  }

  @media (prefers-reduced-motion: reduce) {
      .about-skills-track {
        animation: none;
      }
  }
</style>
