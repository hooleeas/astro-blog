---
import BaseLayout from "../layouts/BaseLayout.astro";
import CreativityLogoSet from "../components/CreativityLogoSet.astro";
import aboutText from "../data/about.jsonc?raw";
import { parseJsonc, type LocalizedText } from "../lib/parse-jsonc";
import { withBase } from "../lib/site-path";

type AboutContent = {
  pageTitle: LocalizedText;
  avatar: { src: string; alt: LocalizedText };
  introduction: { greeting: LocalizedText; detail: LocalizedText };
  contact: {
    title: LocalizedText;
    contacts: { label: LocalizedText; value: string; href?: string }[];
  };
  skillsTitle: LocalizedText;
  logos: {
    name: string;
    color: string;
    labelColor: string;
    icon: string;
    href: string;
  }[];
};

const about = parseJsonc<AboutContent>(aboutText, "src/data/about.jsonc");

const splitIndex = Math.ceil(about.logos.length / 2);
const logoRows = [
  { items: about.logos.slice(0, splitIndex), reverse: false },
  { items: about.logos.slice(splitIndex), reverse: true },
];
const pageTranslations = {
  "zh-Hans": {
    aboutPageTitle: about.pageTitle["zh-Hans"],
    aboutAvatarAlt: about.avatar.alt["zh-Hans"],
    aboutIntroductionGreeting: about.introduction.greeting["zh-Hans"],
    aboutIntroductionDetail: about.introduction.detail["zh-Hans"],
    aboutContactTitle: about.contact.title["zh-Hans"],
    aboutSkillsTitle: about.skillsTitle["zh-Hans"],
    ...Object.fromEntries(about.contact.contacts.map((contact, index) => [`aboutContactLabel${index}`, contact.label["zh-Hans"]])),
  },
  "zh-Hant": {
    aboutPageTitle: about.pageTitle["zh-Hant"],
    aboutAvatarAlt: about.avatar.alt["zh-Hant"],
    aboutIntroductionGreeting: about.introduction.greeting["zh-Hant"],
    aboutIntroductionDetail: about.introduction.detail["zh-Hant"],
    aboutContactTitle: about.contact.title["zh-Hant"],
    aboutSkillsTitle: about.skillsTitle["zh-Hant"],
    ...Object.fromEntries(about.contact.contacts.map((contact, index) => [`aboutContactLabel${index}`, contact.label["zh-Hant"]])),
  },
  ja: {
    aboutPageTitle: about.pageTitle.ja,
    aboutAvatarAlt: about.avatar.alt.ja,
    aboutIntroductionGreeting: about.introduction.greeting.ja,
    aboutIntroductionDetail: about.introduction.detail.ja,
    aboutContactTitle: about.contact.title.ja,
    aboutSkillsTitle: about.skillsTitle.ja,
    ...Object.fromEntries(about.contact.contacts.map((contact, index) => [`aboutContactLabel${index}`, contact.label.ja])),
  },
  ko: {
    aboutPageTitle: about.pageTitle.ko,
    aboutAvatarAlt: about.avatar.alt.ko,
    aboutIntroductionGreeting: about.introduction.greeting.ko,
    aboutIntroductionDetail: about.introduction.detail.ko,
    aboutContactTitle: about.contact.title.ko,
    aboutSkillsTitle: about.skillsTitle.ko,
    ...Object.fromEntries(about.contact.contacts.map((contact, index) => [`aboutContactLabel${index}`, contact.label.ko])),
  },
  en: {
    aboutPageTitle: about.pageTitle.en,
    aboutAvatarAlt: about.avatar.alt.en,
    aboutIntroductionGreeting: about.introduction.greeting.en,
    aboutIntroductionDetail: about.introduction.detail.en,
    aboutContactTitle: about.contact.title.en,
    aboutSkillsTitle: about.skillsTitle.en,
    ...Object.fromEntries(about.contact.contacts.map((contact, index) => [`aboutContactLabel${index}`, contact.label.en])),
  },
};
---

<BaseLayout
  title={about.pageTitle["zh-Hans"]}
  description={about.introduction.detail["zh-Hans"]}
  image={withBase("/og/pages/about.png?v=10")}
  imageAlt={about.pageTitle["zh-Hans"]}
  imageWidth={1800}
  imageHeight={600}
  pageTranslations={pageTranslations}
  titleTranslationKey="aboutPageTitle"
>
  <div class="container about-page">
    <div class="about-profile">
      <img class="about-avatar" src={withBase(about.avatar.src)} alt={about.avatar.alt["zh-Hans"]} data-i18n-alt="aboutAvatarAlt" />
    </div>

    <section class="about-summary" aria-labelledby="about-introduction-title">
      <div class="about-introduction">
        <h2 id="about-introduction-title" data-i18n="aboutIntroductionGreeting">{about.introduction.greeting["zh-Hans"]}</h2>
        <p data-i18n="aboutIntroductionDetail">{about.introduction.detail["zh-Hans"]}</p>
      </div>
      <div class="about-contact">
        <h2 class="about-contact-label" data-i18n="aboutContactTitle">{about.contact.title["zh-Hans"]}</h2>
        <div class="about-contact-methods">
          {about.contact.contacts.map((contact, index) => (
            <div class="about-contact-method">
              <span><span data-i18n={`aboutContactLabel${index}`}>{contact.label["zh-Hans"]}</span>:</span>
              {contact.href ? (
                <a href={withBase(contact.href)}>{contact.value}</a>
              ) : (
                <span>{contact.value}</span>
              )}
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="about-skills" aria-labelledby="about-skills-title">
      <h2 id="about-skills-title" data-i18n="aboutSkillsTitle">{about.skillsTitle["zh-Hans"]}</h2>
      <div
        class="about-skills-marquee"
        role="group"
        aria-label={about.skillsTitle["zh-Hans"]}
        data-i18n-aria="aboutSkillsTitle"
      >
        {logoRows.map(({ items, reverse }) => (
          <div class:list={["about-skills-row", reverse && "about-skills-row-reverse"]}>
            <div class="about-skills-track">
              <CreativityLogoSet items={items} />
              <CreativityLogoSet items={items} hidden />
              <CreativityLogoSet items={items} hidden />
            </div>
          </div>
        ))}
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .about-page {
    padding-top: 28px;
    padding-bottom: 100px;
  }

  .about-profile {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
  }

  .about-avatar {
    display: block;
    width: 180px;
    height: 180px;
    border: 4px solid color-mix(in srgb, var(--text) 16%, transparent);
    border-radius: 50%;
    background: var(--surface);
    object-fit: cover;
    transition: transform 0.25s ease;
  }

  .about-avatar:hover {
    transform: scale(1.08);
  }

  .about-summary {
    display: grid;
    grid-template-columns: minmax(0, 1.5fr) minmax(260px, 0.8fr);
    gap: 18px;
    margin-top: 18px;
  }

  .about-introduction,
  .about-contact {
    min-width: 0;
    min-height: 168px;
    border: 1px solid var(--line);
    border-radius: 20px;
    background: var(--surface);
  }

  .about-introduction {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 8px;
    padding: 26px 30px;
    background: color-mix(in srgb, var(--accent) 30%, var(--surface));
    color: var(--text);
  }

  .about-introduction h2 {
    margin: 0;
    color: var(--text);
    font-size: clamp(1.3rem, 2.2vw, 1.7rem);
    line-height: 1.25;
    letter-spacing: -0.035em;
  }

  .about-introduction p {
    max-width: 680px;
    margin: 0;
    font-size: 0.95rem;
    line-height: 1.7;
  }

  .about-contact {
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 22px 26px;
  }

  .about-contact-label {
    margin: 0;
    color: var(--text);
    font-size: 1.1rem;
    font-weight: 600;
    line-height: 1.3;
  }

  .about-contact-methods {
    display: grid;
    gap: 6px;
    margin-top: 10px;
  }

  .about-contact-method {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 12px;
    color: var(--text);
    font-size: 0.95rem;
    line-height: 1.5;
  }

  .about-contact-method > :first-child {
    min-width: 76px;
    font-weight: 600;
  }

  .about-contact-method a {
    transition: color 0.2s;
  }

  .about-contact-method a:hover {
    color: var(--accent);
  }

  .about-skills-marquee {
    position: absolute;
    inset: 100px 0 34px;
    display: grid;
    grid-template-rows: repeat(2, minmax(0, 1fr));
    align-content: end;
    gap: 14px;
    overflow: hidden;
    pointer-events: none;
  }

  .about-skills-row {
    min-width: 0;
    overflow: hidden;
  }

  .about-skills {
    position: relative;
    min-height: 430px;
    margin-top: 36px;
    padding: 30px 32px;
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: 21px;
    background: var(--surface);
  }

  .about-skills h2 {
    position: relative;
    z-index: 1;
    margin: 0;
    color: var(--text);
    font-size: clamp(2rem, 3.8vw, 2.65rem);
    line-height: 1.15;
    letter-spacing: -0.04em;
  }

  .about-skills-track {
    display: flex;
    width: max-content;
    animation: about-skills-scroll 68s linear infinite;
    will-change: transform;
  }

  :global(html[data-about-carousel-transition]) .about-skills-track {
    animation-play-state: paused;
  }

  .about-skills-row-reverse .about-skills-track {
    animation-direction: reverse;
    animation-duration: 75s;
  }

  .about-skills-track :global(.creativity-set) {
    align-items: flex-end;
    gap: 14px;
    padding: 0 14px 0 0;
  }

  .about-skills-track :global(.creativity-logo) {
    width: 140px;
    border-radius: 22px;
    background: var(--logo-bg);
    opacity: 1;
  }

  .about-skills-track :global(.creativity-logo img) {
    width: 70%;
    height: 70%;
  }

  @keyframes about-skills-scroll {
    to {
      transform: translateX(-33.333333%);
    }
  }

  @media (max-width: 680px) {
    .about-page {
      padding-top: 22px;
      padding-bottom: 60px;
    }

    .about-avatar {
      width: 150px;
      height: 150px;
    }

    .about-summary {
      grid-template-columns: 1fr;
      gap: 12px;
      margin-top: 14px;
    }

    .about-introduction,
    .about-contact {
      min-height: 0;
    }

    .about-introduction {
      padding: 22px;
    }

    .about-introduction p {
      font-size: 0.9rem;
    }

    .about-introduction h2 {
      font-size: 1.35rem;
    }

    .about-contact {
      padding: 16px 22px 18px;
      border-top: 1px solid var(--line);
      border-left: 0;
    }

    .about-skills {
      min-height: 0;
      margin-top: 28px;
      padding: 22px 16px;
    }

    .about-skills-marquee {
      position: relative;
      inset: auto;
      grid-template-rows: repeat(2, 58px);
      gap: 6px;
      margin-top: 14px;
      width: calc(100% + 32px);
      margin-inline: -16px;
    }

    .about-skills-row {
      display: block;
      overflow: hidden;
    }

    .about-skills-track {
      display: flex;
      width: max-content;
      animation: about-skills-scroll 68s linear infinite;
      will-change: transform;
    }

    .about-skills-track :global(.creativity-set) {
      display: flex;
      flex: none;
      gap: 6px;
      padding-right: 6px;
    }

    .about-skills-track :global(.creativity-logo) {
      flex: none;
      width: 58px;
      height: 58px;
      max-height: none;
      aspect-ratio: 1;
      border-radius: 10px;
    }

    .about-skills-track :global(.creativity-logo img) {
      width: 70%;
      height: 70%;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .about-avatar {
      transition: none;
    }

    .about-avatar:hover {
      transform: none;
    }

    .about-skills-track {
      animation: none;
    }
  }
</style>
